{
    "openapi": "3.0.3",
    "info": {
        "title": "Global Moto Rentals API",
        "description": "REST API for managing motorcycle rental listings, shops, brands, categories, and locations. Designed for MCP and AI Agent integration.",
        "version": "1.0.0",
        "contact": {
            "name": "API Support"
        }
    },
    "servers": [
        {
            "url": "/api/v1",
            "description": "API v1"
        }
    ],
    "security": [
        {
            "bearerAuth": []
        }
    ],
    "paths": {
        "/motorcycles": {
            "get": {
                "summary": "List motorcycles",
                "description": "Get a paginated list of motorcycles with optional filters",
                "operationId": "listMotorcycles",
                "tags": [
                    "Motorcycles"
                ],
                "security": [],
                "parameters": [
                    {
                        "$ref": "#/components/parameters/limit"
                    },
                    {
                        "$ref": "#/components/parameters/offset"
                    },
                    {
                        "name": "brandId",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        },
                        "description": "Filter by brand ID"
                    },
                    {
                        "name": "categoryId",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        },
                        "description": "Filter by category ID"
                    },
                    {
                        "name": "countryCode",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        },
                        "description": "Filter by country code (e.g., TH, VN)"
                    },
                    {
                        "name": "cityId",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        },
                        "description": "Filter by city ID"
                    },
                    {
                        "name": "search",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        },
                        "description": "Search query"
                    },
                    {
                        "name": "minPrice",
                        "in": "query",
                        "schema": {
                            "type": "integer"
                        },
                        "description": "Minimum daily price"
                    },
                    {
                        "name": "maxPrice",
                        "in": "query",
                        "schema": {
                            "type": "integer"
                        },
                        "description": "Maximum daily price"
                    },
                    {
                        "name": "sortBy",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "price_asc",
                                "price_desc",
                                "newest",
                                "rating_desc"
                            ]
                        },
                        "description": "Sort order"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "List of motorcycles",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/MotorcycleListResponse"
                                }
                            }
                        }
                    },
                    "429": {
                        "$ref": "#/components/responses/RateLimited"
                    },
                    "500": {
                        "$ref": "#/components/responses/InternalError"
                    }
                }
            },
            "post": {
                "summary": "Create motorcycle",
                "description": "Create a new motorcycle listing (admin only)",
                "operationId": "createMotorcycle",
                "tags": [
                    "Motorcycles"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/MotorcycleCreate"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Motorcycle created",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/MotorcycleResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "$ref": "#/components/responses/BadRequest"
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    }
                }
            }
        },
        "/motorcycles/{id}": {
            "get": {
                "summary": "Get motorcycle",
                "description": "Get a single motorcycle by ID",
                "operationId": "getMotorcycle",
                "tags": [
                    "Motorcycles"
                ],
                "security": [],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        },
                        "description": "Motorcycle ID"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Motorcycle details",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/MotorcycleResponse"
                                }
                            }
                        }
                    },
                    "404": {
                        "$ref": "#/components/responses/NotFound"
                    }
                }
            },
            "put": {
                "summary": "Update motorcycle",
                "description": "Update a motorcycle (admin only)",
                "operationId": "updateMotorcycle",
                "tags": [
                    "Motorcycles"
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/MotorcycleUpdate"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Motorcycle updated"
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "404": {
                        "$ref": "#/components/responses/NotFound"
                    }
                }
            },
            "delete": {
                "summary": "Delete motorcycle",
                "description": "Delete a motorcycle (admin only)",
                "operationId": "deleteMotorcycle",
                "tags": [
                    "Motorcycles"
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Motorcycle deleted"
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    }
                }
            }
        },
