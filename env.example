# ===========================================
# 🐳 LOCAL DOCKER SUPABASE ENVIRONMENT
# Run: supabase status (to get keys)
# ===========================================
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_local_anon_key_from_supabase_status
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# SUPABASE_SERVICE_ROLE_KEY=your_local_service_role_key_from_supabase_status
# ENVIRONMENT=local

# ===========================================
# ☁️ LIVE SUPABASE CLOUD ENVIRONMENT
# Get from: Supabase Dashboard → Settings → API
# ===========================================
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_live_anon_key_from_dashboard
# DATABASE_URL=postgresql://postgres.your-project-id:[YOUR-PASSWORD]@aws-region.pooler.supabase.com:6543/postgres
# SUPABASE_SERVICE_ROLE_KEY=your_live_service_role_key_from_dashboard
# ENVIRONMENT=production

# ===========================================
# 📊 ANALYTICS & TRACKING
# ===========================================
# Google Analytics 4 - Get from: https://analytics.google.com
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA4_TRACKING_ID=G-PLACEHOLDER123

# Site URL for analytics and sitemap generation
NEXT_PUBLIC_SITE_URL=http://localhost:3000 

# ===========================================
# 🔑 MCP API KEYS
# Generate with: openssl rand -hex 20
# ===========================================
# Read-only API key (GET endpoints only)
MCP_KEY_READ_ONLY=

# Admin API key (full read/write access)
MCP_KEY_ADMIN=

# ===========================================
# AI CHAT (server-only; do not use NEXT_PUBLIC_ prefixes)
# OPENAI_API_KEY is required for AI responses.
# Optional access lock: unset/empty/whitespace-only means public chat at /ai-chat.
# Set a non-empty secret to require /ai-chat?secret=<your-access-code>.
# Generate a new access code with: openssl rand -hex 32
# Restart/redeploy after changing these values.
# ===========================================
OPENAI_API_KEY=
AI_CHAT_ACCESS_SECRET=
