# ===========================================
# 🐳 LOCAL DOCKER SUPABASE ENVIRONMENT
# Run: supabase status (to get keys)
# ===========================================
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_local_anon_key_from_supabase_status
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# SUPABASE_SERVICE_ROLE_KEY=your_local_service_role_key_from_supabase_status
# ENVIRONMENT=local

# ===========================================
# ☁️ LIVE SUPABASE CLOUD ENVIRONMENT
# Get from: Supabase Dashboard → Settings → API
# ===========================================
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_live_anon_key_from_dashboard
# DATABASE_URL=postgresql://postgres.your-project-id:[YOUR-PASSWORD]@aws-region.pooler.supabase.com:6543/postgres
# SUPABASE_SERVICE_ROLE_KEY=your_live_service_role_key_from_dashboard
# ENVIRONMENT=production 